{
  "properties": {
    "activities": [
      {
        "name": "ForEach Config Table",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "Lookup Config table names",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('Lookup Config table names').output.resultsets[0].rows\n",
            "type": "Expression"
          },
          "isSequential": false,
          "activities": [
            {
              "name": "Copy Config File",
              "type": "Copy",
              "dependsOn": [],
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "source": {
                  "type": "FabricSqlDatabaseSource",
                  "queryTimeout": "02:00:00",
                  "partitionOption": "None",
                  "datasetSettings": {
                    "annotations": [],
                    "connectionSettings": {
                      "name": "0d5adb64_4604_447a_b298_3dbd4f6725c0",
                      "properties": {
                        "annotations": [],
                        "type": "FabricSqlDatabase",
                        "typeProperties": {
                          "workspaceId": "@pipeline().DataFactory",
                          "artifactId": "@pipeline().libraryVariables.MetaDatabaseID"
                        },
                        "externalReferences": {
                          "connection": "@pipeline().libraryVariables.MetaConnectionID"
                        }
                      }
                    },
                    "type": "FabricSqlDatabaseTable",
                    "schema": [],
                    "typeProperties": {
                      "schema": "config",
                      "table": {
                        "value": "@item().Name",
                        "type": "Expression"
                      }
                    }
                  }
                },
                "sink": {
                  "type": "ParquetSink",
                  "storeSettings": {
                    "type": "AzureBlobStorageWriteSettings"
                  },
                  "formatSettings": {
                    "type": "ParquetWriteSettings",
                    "enableVertiParquet": true
                  },
                  "datasetSettings": {
                    "annotations": [],
                    "connectionSettings": {
                      "name": "98958ea7_d33c_43d0_b61a_2cb716861365",
                      "properties": {
                        "annotations": [],
                        "type": "Lakehouse",
                        "typeProperties": {
                          "workspaceId": "@pipeline().DataFactory",
                          "artifactId": "@pipeline().libraryVariables.DefaultLakehouseID",
                          "rootFolder": "Files"
                        },
                        "externalReferences": {
                          "connection": "@pipeline().libraryVariables.LakehouseConnectionID"
                        }
                      }
                    },
                    "type": "Parquet",
                    "typeProperties": {
                      "location": {
                        "type": "LakehouseLocation",
                        "fileName": {
                          "value": "@{concat(item().Name,'.parquet')}",
                          "type": "Expression"
                        },
                        "folderPath": {
                          "value": "backup/config/@{formatDateTime(utcnow(),'yyyyMMdd')}",
                          "type": "Expression"
                        }
                      },
                      "compressionCodec": "snappy"
                    },
                    "schema": []
                  }
                },
                "enableStaging": false,
                "translator": {
                  "type": "TabularTranslator",
                  "typeConversion": true,
                  "typeConversionSettings": {
                    "allowDataTruncation": true,
                    "treatBooleanAsNumber": false
                  }
                }
              }
            }
          ]
        }
      },
      {
        "name": "Lookup Config table names",
        "type": "Script",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "connectionSettings": {
          "name": "145d51bb_7f98_4e3e_800d_0ef1180e3308",
          "properties": {
            "annotations": [],
            "type": "FabricSqlDatabase",
            "typeProperties": {
              "workspaceId": "@pipeline().DataFactory",
              "artifactId": "@pipeline().libraryVariables.MetaDatabaseID"
            },
            "externalReferences": {
              "connection": "@pipeline().libraryVariables.MetaConnectionID"
            }
          }
        },
        "typeProperties": {
          "scripts": [
            {
              "type": "Query",
              "text": {
                "value": "config.usp_GetTables",
                "type": "Expression"
              }
            }
          ],
          "scriptBlockExecutionTimeout": "02:00:00"
        }
      }
    ],
    "libraryVariables": {
      "MetaConnectionID": {
        "type": "String",
        "variableName": "MetaConnectionID",
        "libraryName": "Environment"
      },
      "MetaDatabaseID": {
        "type": "String",
        "variableName": "MetaDatabaseID",
        "libraryName": "Environment"
      },
      "DefaultLakehouseID": {
        "type": "String",
        "variableName": "DefaultLakehouseID",
        "libraryName": "Environment"
      },
      "LakehouseConnectionID": {
        "type": "String",
        "variableName": "LakehouseConnectionID",
        "libraryName": "Environment"
      }
    }
  }
}