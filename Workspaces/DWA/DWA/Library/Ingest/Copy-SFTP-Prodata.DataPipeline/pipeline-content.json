{
  "properties": {
    "activities": [
      {
        "name": "Copy-SFTP-Prodata",
        "type": "Copy",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "BinarySource",
            "storeSettings": {
              "type": "SftpReadSettings",
              "recursive": {
                "value": "@if(contains(json(string(pipeline().parameters.SourceSettings)),'recurisve'), bool(json(string(pipeline().parameters.SourceSettings)).recurisve), false)",
                "type": "Expression"
              },
              "wildcardFolderPath": {
                "value": "@json(string(pipeline().parameters.SourceSettings)).directory",
                "type": "Expression"
              },
              "wildcardFileName": {
                "value": "@json(string(pipeline().parameters.SourceSettings)).file",
                "type": "Expression"
              },
              "deleteFilesAfterCompletion": false,
              "disableChunking": false
            },
            "formatSettings": {
              "type": "BinaryReadSettings"
            },
            "datasetSettings": {
              "annotations": [],
              "type": "Binary",
              "typeProperties": {
                "location": {
                  "type": "SftpLocation"
                }
              },
              "externalReferences": {
                "connection": "1a8439c4-a50b-4ef5-82d2-d150be2f91f7"
              }
            }
          },
          "sink": {
            "type": "BinarySink",
            "storeSettings": {
              "type": "AzureBlobStorageWriteSettings",
              "copyBehavior": "PreserveHierarchy"
            },
            "datasetSettings": {
              "annotations": [],
              "linkedService": {
                "name": "5be552d7_c8d0_4522_9dff_67ecf77756c0",
                "properties": {
                  "annotations": [],
                  "type": "Lakehouse",
                  "typeProperties": {
                    "workspaceId": "@if(contains(pipeline().parameters.TargetConnectionSettings,'worspaceId'),json(string(pipeline().parameters.TargetConnectionSettings)).workspaceId,pipeline().DataFactory)",
                    "artifactId": "@if(contains(pipeline().parameters.TargetConnectionSettings,'lakehouseId'),json(string(pipeline().parameters.TargetConnectionSettings)).workspaceId,pipeline().libraryVariables.DefaultLakehouseID)",
                    "rootFolder": "Files"
                  }
                }
              },
              "type": "Binary",
              "typeProperties": {
                "location": {
                  "type": "LakehouseLocation",
                  "folderPath": {
                    "value": "@json(string(pipeline().parameters.TargetSettings)).directory",
                    "type": "Expression"
                  }
                }
              }
            }
          },
          "enableStaging": false
        }
      }
    ],
    "parameters": {
      "SourceSettings": {
        "type": "string",
        "defaultValue": {
          "directory": "/aw/",
          "file": "*.*"
        }
      },
      "TargetSettings": {
        "type": "string",
        "defaultValue": {
          "directory": "landing/AdventureWorks/erp"
        }
      },
      "SourceConnectionSettings": {
        "type": "string",
        "defaultValue": {}
      },
      "TargetConnectionSettings": {
        "type": "string",
        "defaultValue": {}
      },
      "ActivitySettings": {
        "type": "string"
      },
      "LineageKey": {
        "type": "string"
      }
    },
    "libraryVariables": {
      "DefaultLakehouseID": {
        "type": "String",
        "variableName": "DefaultLakehouseID",
        "libraryName": "Environment"
      }
    }
  }
}